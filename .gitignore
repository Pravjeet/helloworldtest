# Firebase CLI's local deploy cache — regenerated on every `firebase deploy`.
.firebase/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Records which firestore.rules version this machine last deployed
.rules-deployed

# ---------------------------------------------------------------------
# Admin tooling (tools/)
#
# NEVER commit a service-account key. It is the master credential for the
# whole Firebase project — anyone holding it can read, write or delete
# every account and every document, with no password. If one is ever
# committed by accident, revoke it in the Firebase console immediately;
# removing the file from a later commit is NOT enough, it stays in history.
# ---------------------------------------------------------------------
serviceAccountKey.json
**/serviceAccountKey.json
*-firebase-adminsdk-*.json
tools/node_modules/
tools/backups/

# Local editor/assistant scratch — machine-specific, not project config.
.claude/
CLAUDE.md

# ---------------------------------------------------------------------
# Student rosters
#
# Import sheets carry real students' names, registration numbers, home
# addresses and personal email addresses. Git history is effectively
# permanent and this repository is shared, so a roster committed once is
# a disclosure that cannot be taken back by deleting the file later.
#
# Keep the sheet on disk and work with it normally — it just never
# becomes a commit. Nothing tracked matches these patterns today; if a
# blank template ever genuinely needs versioning, `git add -f` it.
# ---------------------------------------------------------------------
*.csv
*.xlsx
*.xls
rules-tests/node_modules/
rules-tests/firestore-debug.log
